# ---------- DRIVE project .gitignore ----------

# Raw and derived data -- never commit datasets (large, and source stays unchanged)
data/raw/
data/interim/
data/processed/
data/evaluation/
outputs/
downloads/
*.zip
*.csv
*.parquet
*.gz

# Allow small bundled docs/figures if ever needed
!**/assets/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
*.yaml.bak

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
